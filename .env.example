# Copy to .env and fill in real values.
# All of these are gitignored — never commit real credentials.

# Google Calendar OAuth2 — from credentials.json (downloaded from GCP Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Obtained by running: node scripts/oauth-setup.js
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Which calendar to use ( "primary" or a specific calendar ID/email)
GOOGLE_CALENDAR_ID=primary

# Server port (default 3000)
PORT=3000
